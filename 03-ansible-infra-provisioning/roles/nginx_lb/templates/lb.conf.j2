# {{ ansible_managed }}
upstream app_backend {
{% if lb_algorithm in ['least_conn', 'ip_hash'] %}
    {{ lb_algorithm }};
{% endif %}
{% for host in groups[lb_backend_group] %}
    server {{ hostvars[host].ansible_host }}:{{ lb_backend_port }} max_fails={{ lb_max_fails }} fail_timeout={{ lb_fail_timeout }}{{ ' down' if host in lb_drained_hosts else '' }};  # {{ host }}
{% endfor %}
    keepalive 16;
}

log_format upstreamlog '$remote_addr [$time_local] "$request" $status '
                       'upstream=$upstream_addr rt=$request_time urt=$upstream_response_time';

server {
    listen {{ lb_listen_port }} default_server;
    server_name _;
    access_log /var/log/nginx/lb_access.log upstreamlog;

    location / {
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_connect_timeout 2s;
        add_header X-Upstream $upstream_addr always;
    }

    location = /lb-status {
        stub_status;
        allow 127.0.0.1;
        allow {{ monitoring_allowed_cidr }};
        deny all;
    }
}
